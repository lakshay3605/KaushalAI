    {
      "id": "hZpca2UP3FU83599XUSNv",
      "x": -264,
      "y": 1408,
      "width": 374.304,
      "height": 520,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
