  "boundaries": [
    { "id": "cloud", "kind": "aws-cloud", "label": "AWS Cloud", "col": 1, "row": 0, "cols": 4, "rows": 2, "padLeft": 55, "padTop": 60, "padRight": 55, "padBottom": 30 },
    { "id": "pipeline", "kind": "scope", "label": "Ingestion pipeline", "color": "#E7157B", "dashed": false, "parent": "cloud", "col": 1, "row": 0, "cols": 2, "rows": 1, "padLeft": 30, "padTop": 42, "padRight": 30, "padBottom": 12 }
  ],

  "nodes": [
    { "id": "src", "kind": "box", "label": "Source systems", "col": 0, "row": 0, "width": 170, "height": 110 },
    { "id": "note", "kind": "note", "label": "Assumption: hourly batch ingestion, single region.", "col": 0, "row": 1, "width": 190, "height": 74 },

    { "id": "ingest", "kind": "icon", "icon": "lambda", "label": "Ingestion function", "parent": "pipeline", "col": 1, "row": 0 },
    { "id": "raw", "kind": "icon", "icon": "simple storage service", "label": "Raw zone", "parent": "pipeline", "col": 2, "row": 0 },

    { "id": "index", "kind": "icon", "icon": "opensearch", "label": "Search index\nOpenSearch", "parent": "cloud", "col": 3, "row": 0 },
    { "id": "agent", "kind": "icon", "icon": "bedrock", "label": "Analysis model", "parent": "cloud", "col": 4, "row": 0 },

    { "id": "schedule", "kind": "icon", "icon": "eventbridge", "label": "Schedule", "parent": "cloud", "col": 1, "row": 1 },
    { "id": "metrics", "kind": "icon", "icon": "timestream", "label": "Metric store", "parent": "cloud", "col": 3, "row": 1 },
    { "id": "alarms", "kind": "icon", "icon": "cloudwatch", "label": "Alarms", "parent": "cloud", "col": 4, "row": 1 }
